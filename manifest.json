{
  "manifest_version": 3,
  "name": "Chess Blocker",
  "version": "1.0",
  "description": "Blocks chess after too many games",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "*://www.chess.com/*",
    "*://lichess.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.chess.com/*",
        "*://lichess.org/*"
      ],
      "js": ["content.js"]
    }
  ]
}